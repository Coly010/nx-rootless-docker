{
  "name": "api",
  "nx": {
    "root": "packages/api",
    "targets": {
      "docker:build": {
        "executor": "nx:run-commands",
        "options": {
          "commands": [
            "docker buildx create --name mybuilder --driver docker-container --bootstrap",
            "docker buildx use mybuilder",
            "docker buildx build ."
            ]
        }
      }
    }
  }
}